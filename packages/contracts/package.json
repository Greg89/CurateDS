{
  "name": "@curateds/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./attributes": {
      "types": "./src/attributes.ts",
      "default": "./src/attributes.ts"
    },
    "./collections": {
      "types": "./src/collections.ts",
      "default": "./src/collections.ts"
    },
    "./item-types": {
      "types": "./src/item-types.ts",
      "default": "./src/item-types.ts"
    },
    "./items": {
      "types": "./src/items.ts",
      "default": "./src/items.ts"
    },
    "./locations": {
      "types": "./src/locations.ts",
      "default": "./src/locations.ts"
    },
    "./media": {
      "types": "./src/media.ts",
      "default": "./src/media.ts"
    },
    "./saved-views": {
      "types": "./src/saved-views.ts",
      "default": "./src/saved-views.ts"
    },
    "./tags": {
      "types": "./src/tags.ts",
      "default": "./src/tags.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
