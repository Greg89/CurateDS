{
  "name": "@curateds/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attributes": {
      "types": "./dist/attributes.d.ts",
      "default": "./dist/attributes.js"
    },
    "./collections": {
      "types": "./dist/collections.d.ts",
      "default": "./dist/collections.js"
    },
    "./item-types": {
      "types": "./dist/item-types.d.ts",
      "default": "./dist/item-types.js"
    },
    "./items": {
      "types": "./dist/items.d.ts",
      "default": "./dist/items.js"
    },
    "./locations": {
      "types": "./dist/locations.d.ts",
      "default": "./dist/locations.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "default": "./dist/media.js"
    },
    "./saved-views": {
      "types": "./dist/saved-views.d.ts",
      "default": "./dist/saved-views.js"
    },
    "./tags": {
      "types": "./dist/tags.d.ts",
      "default": "./dist/tags.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
