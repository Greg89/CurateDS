{
  "name": "curateds",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "tests/Web.UnitTests",
    "tests/EndToEndTests"
  ],
  "scripts": {
    "verify": "dotnet test CurateDS.sln --verbosity minimal && npm run build:web && npm run test:web -- --run",
    "build:web": "npm run build --workspace @curateds/web",
    "test:web": "npm run test --workspace @curateds/web-tests",
    "test:web:coverage": "npm run test:coverage --workspace @curateds/web-tests",
    "test:web:watch": "npm run test:watch --workspace @curateds/web-tests",
    "test:e2e": "npm run test --workspace @curateds/e2e",
    "typecheck:mobile": "npm run typecheck --workspace @curateds/mobile",
    "test:mobile": "npm run test --workspace @curateds/mobile",
    "test:mobile:coverage": "npm run test:coverage --workspace @curateds/mobile"
  },
  "overrides": {
    "react-test-renderer": "19.2.5",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "uuid": "^14.0.0",
    "xcode": {
      "uuid": "^14.0.0"
    },
    "jest-environment-jsdom": {
      "http-proxy-agent": "^6.1.1"
    },
    "@expo/metro-config": {
      "postcss": "^8.5.10"
    }
  },
  "devDependencies": {
    "uuid": "^14.0.0"
  }
}
