{
  "name": "curateds",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/web-v2",
    "tests/Web.UnitTests",
    "tests/EndToEndTests"
  ],
  "scripts": {
    "verify": "dotnet test CurateDS.sln --verbosity minimal && npm run build:web && npm run test:web && npm run build:web:legacy && npm run test:web:legacy -- --run",
    "dev:web-v2": "npm run dev --workspace @curateds/web-v2",
    "build:web-v2": "npm run build --workspace @curateds/web-v2",
    "test:web-v2": "npm run test --workspace @curateds/web-v2",
    "build:web": "npm run build --workspace @curateds/web-v2",
    "test:web": "npm run test --workspace @curateds/web-v2",
    "test:web:coverage": "npm run test:coverage --workspace @curateds/web-tests",
    "test:web:watch": "npm run test:watch --workspace @curateds/web-tests",
    "test:e2e": "npm run test:e2e --workspace @curateds/web-v2",
    "build:web:legacy": "npm run build --workspace @curateds/web",
    "test:web:legacy": "npm run test --workspace @curateds/web-tests"
  },
  "overrides": {
    "postcss": "8.5.25",
    "nanoid": "^3.3.18",
    "undici": "7.29.1",
    "vite": "^8.1.0",
    "uuid": "^14.0.0",
    "jest-environment-jsdom": {
      "http-proxy-agent": "^6.1.1"
    }
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "react-test-renderer": "^19.2.7",
    "uuid": "^14.0.0",
    "vitest": "^4.1.11"
  }
}
