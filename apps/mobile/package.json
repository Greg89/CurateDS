{
  "name": "@curateds/mobile",
  "version": "0.0.1",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-auth-session": "~55.0.15",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~55.0.14",
    "react": "19.2.5",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "~13.3.3",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.14",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.2.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^react$": "<rootDir>/../../node_modules/react",
      "^react/(.*)$": "<rootDir>/../../node_modules/react/$1"
    }
  }
}
